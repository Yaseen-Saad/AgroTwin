# Copy to .env and fill locally. Never commit .env.

# Scout ingestion bearer token
AGROTWIN_SCOUT_TOKEN=change-me

# API bind address
AGROTWIN_API_HOST=127.0.0.1
AGROTWIN_API_PORT=8000

# NASA Earthdata account used by AppEEARS, SMAP and MODIS extracts.
# Credentials are read from the environment only and never written to disk.
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# Optional Council language-model provider (templates are used when unset)
AGROTWIN_LLM_PROVIDER=
AGROTWIN_LLM_API_KEY=
AGROTWIN_LLM_MODEL=

# P1 Open-Meteo seasonal outlook (non-NASA data, disclosed when enabled)
OPEN_METEO_ENABLED=false
