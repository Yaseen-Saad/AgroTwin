{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rotation.schema.json",
  "title": "AgroTwin rotation request",
  "description": "A three-year crop rotation: up to two seasons per year, fallow allowed. Crops must exist in engine/crops.yaml.",
  "x-schema-version": "1.0.0",
  "x-generated-by": "agent-0 / opencode/big-pickle / 2026-11-14",
  "type": "object",
  "required": ["rotation_id", "label", "slots", "generated_by"],
  "additionalProperties": false,
  "properties": {
    "generated_by": {
      "type": "string",
      "minLength": 1
    },
    "rotation_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_]*$"
    },
    "label": {
      "type": "string",
      "minLength": 1
    },
    "is_existing": {
      "type": "boolean"
    },
    "slots": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": ["year", "season", "crop"],
        "additionalProperties": false,
        "properties": {
          "year": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          },
          "season": {
            "type": "string",
            "enum": ["winter", "summer"]
          },
          "crop": {
            "type": "string",
            "enum": [
              "wheat",
              "maize",
              "sorghum",
              "berseem_clover",
              "faba_bean",
              "sugar_beet",
              "cotton",
              "fallow"
            ]
          },
          "notes": {
            "type": "string"
          }
        }
      }
    }
  }
}
