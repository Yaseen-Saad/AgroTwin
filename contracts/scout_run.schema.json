{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "scout_run.schema.json",
  "title": "AgroTwin Verdex Scout run",
  "description": "Sensor run posted by the Verdex Scout or its laptop bridge. mode is mandatory and travels to every screen.",
  "x-schema-version": "1.0.0",
  "x-generated-by": "agent-0 / opencode/big-pickle / 2026-11-14",
  "type": "object",
  "required": ["run_id", "site_id", "mode", "robot", "sent_at", "fw", "points", "generated_by"],
  "additionalProperties": false,
  "properties": {
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "site_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_]*$"
    },
    "mode": {
      "type": "string",
      "enum": ["LIVE", "REPLAY", "SIMULATED"]
    },
    "robot": {
      "type": "string",
      "const": "verdex"
    },
    "sent_at": {
      "type": "string",
      "format": "date-time"
    },
    "fw": {
      "type": "string",
      "minLength": 1
    },
    "generated_by": {
      "type": "string",
      "minLength": 1
    },
    "points": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "t",
          "plot_label",
          "soil_raw",
          "air_temp_c",
          "air_rh_pct",
          "rain_flag",
          "plant_health"
        ],
        "additionalProperties": false,
        "properties": {
          "t": {
            "type": "string",
            "format": "date-time"
          },
          "lat": {
            "type": ["number", "null"],
            "minimum": -90,
            "maximum": 90
          },
          "lon": {
            "type": ["number", "null"],
            "minimum": -180,
            "maximum": 180
          },
          "plot_label": {
            "type": "string",
            "minLength": 1
          },
          "soil_raw": {
            "type": "number",
            "minimum": 0
          },
          "soil_vwc_pct": {
            "type": ["number", "null"],
            "minimum": 0,
            "maximum": 100
          },
          "soil_calibration_id": {
            "type": ["string", "null"],
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "air_temp_c": {
            "type": "number",
            "minimum": -50,
            "maximum": 70
          },
          "air_rh_pct": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "rain_flag": {
            "type": "boolean"
          },
          "plant_health": {
            "type": "object",
            "required": ["label", "confidence", "model"],
            "additionalProperties": false,
            "properties": {
              "label": {
                "type": "string",
                "enum": ["healthy", "diseased", "unknown"]
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "model": {
                "type": "string",
                "minLength": 1
              },
              "image_ref": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
