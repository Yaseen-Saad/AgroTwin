{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "replay.schema.json",
  "title": "AgroTwin replay metrics",
  "description": "Agronomic output of the historical-analog replay: one window per start year and rotation. Economics are added later by engine/econ.py.",
  "x-schema-version": "1.0.0",
  "x-generated-by": "agent-0 / opencode/big-pickle / 2026-11-14",
  "type": "object",
  "required": ["site_id", "scenario", "mode", "years", "rotations", "generated_by"],
  "additionalProperties": false,
  "properties": {
    "site_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_]*$"
    },
    "generated_by": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "type": "string",
      "enum": ["LIVE", "REPLAY", "SIMULATED", "NONE"]
    },
    "years": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "integer",
        "minimum": 1981,
        "maximum": 2100
      }
    },
    "scenario": {
      "type": "object",
      "required": ["rain_mult", "temp_offset_c", "price_mult"],
      "additionalProperties": false,
      "properties": {
        "rain_mult": {
          "type": "number",
          "minimum": 0,
          "maximum": 3
        },
        "temp_offset_c": {
          "type": "number",
          "minimum": -10,
          "maximum": 10
        },
        "price_mult": {
          "type": "number",
          "minimum": 0,
          "maximum": 5
        }
      }
    },
    "rotations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["rotation_id", "label", "windows"],
        "additionalProperties": false,
        "properties": {
          "rotation_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_]*$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "windows": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "start_year",
                "years",
                "water_use_mm",
                "irrigation_mm",
                "deficit_days",
                "stress_days",
                "bare_days",
                "erosion_index",
                "max_depletion_mm",
                "n_credit_kg_ha",
                "source"
              ],
              "additionalProperties": false,
              "properties": {
                "start_year": {
                  "type": "integer",
                  "minimum": 1981,
                  "maximum": 2100
                },
                "years": {
                  "type": "array",
                  "minItems": 3,
                  "maxItems": 3,
                  "items": {
                    "type": "integer",
                    "minimum": 1981,
                    "maximum": 2100
                  }
                },
                "water_use_mm": {
                  "type": "number",
                  "minimum": 0
                },
                "irrigation_mm": {
                  "type": "number",
                  "minimum": 0
                },
                "deficit_days": {
                  "type": "integer",
                  "minimum": 0
                },
                "stress_days": {
                  "type": "integer",
                  "minimum": 0
                },
                "bare_days": {
                  "type": "integer",
                  "minimum": 0
                },
                "erosion_index": {
                  "type": "number",
                  "minimum": 0
                },
                "max_depletion_mm": {
                  "type": "number",
                  "minimum": 0
                },
                "n_credit_kg_ha": {
                  "type": "object",
                  "required": ["low", "high", "source"],
                  "additionalProperties": false,
                  "properties": {
                    "low": {
                      "type": "number",
                      "minimum": 0
                    },
                    "high": {
                      "type": "number",
                      "minimum": 0
                    },
                    "source": {
                      "$ref": "#/$defs/sourceTag"
                    }
                  }
                },
                "source": {
                  "$ref": "#/$defs/sourceTag"
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "sourceTag": {
      "type": "string",
      "pattern": "^(nasa:[A-Za-z0-9_.:-]+|computed|scout:[A-Za-z0-9_.:-]+|quoted:https?://\\S+|assumption:[a-z0-9_]+)$"
    }
  }
}
