{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "site.schema.json",
  "title": "AgroTwin site cache",
  "description": "One cached field site: NASA POWER daily weather plus optional monthly vegetation and soil-moisture extracts.",
  "x-schema-version": "1.0.0",
  "x-generated-by": "agent-0 / opencode/big-pickle / 2026-11-14",
  "type": "object",
  "required": ["site_id", "name", "lat", "lon", "generated_by", "daily"],
  "additionalProperties": false,
  "properties": {
    "site_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "lat": {
      "type": "number",
      "minimum": -90,
      "maximum": 90
    },
    "lon": {
      "type": "number",
      "minimum": -180,
      "maximum": 180
    },
    "elevation_m": {
      "type": ["number", "null"],
      "minimum": -500,
      "maximum": 9000
    },
    "irrigation": {
      "type": "string",
      "enum": ["irrigated", "rainfed"]
    },
    "soil_class": {
      "type": "string",
      "enum": ["sand", "sandy_loam", "loam", "clay_loam", "clay"]
    },
    "timezone": {
      "type": "string",
      "default": "UTC"
    },
    "generated_by": {
      "type": "string",
      "minLength": 1
    },
    "daily": {
      "type": "object",
      "required": ["source", "start", "columns", "rows"],
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "string",
          "pattern": "^nasa:POWER"
        },
        "start": {
          "type": "string",
          "format": "date"
        },
        "columns": {
          "type": "array",
          "minItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "allOf": [
            {"contains": {"const": "date"}},
            {"contains": {"const": "tmean_c"}},
            {"contains": {"const": "tmin_c"}},
            {"contains": {"const": "tmax_c"}},
            {"contains": {"const": "precip_mm"}},
            {"contains": {"const": "rh_pct"}},
            {"contains": {"const": "wind_ms"}},
            {"contains": {"const": "solar_mj_m2"}}
          ]
        },
        "rows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 8,
            "items": {
              "type": ["string", "number", "null"]
            }
          }
        }
      }
    },
    "monthly_ndvi": {
      "type": ["object", "null"],
      "required": ["source", "values"],
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "string",
          "pattern": "^nasa:"
        },
        "values": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["month", "ndvi"],
            "additionalProperties": false,
            "properties": {
              "month": {
                "type": "string",
                "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"
              },
              "ndvi": {
                "type": ["number", "null"],
                "minimum": -1,
                "maximum": 1
              }
            }
          }
        }
      }
    },
    "monthly_soil_moisture": {
      "type": ["object", "null"],
      "required": ["source", "values"],
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "string",
          "pattern": "^nasa:"
        },
        "values": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["month", "m3_m3"],
            "additionalProperties": false,
            "properties": {
              "month": {
                "type": "string",
                "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"
              },
              "m3_m3": {
                "type": ["number", "null"],
                "minimum": 0,
                "maximum": 1
              }
            }
          }
        }
      }
    }
  }
}
